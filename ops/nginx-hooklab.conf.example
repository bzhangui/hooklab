# Example only: replace the domain and certificate paths, then run nginx -t.
# The Node.js service must remain bound to 127.0.0.1:8787 on this host.
limit_req_zone $binary_remote_addr zone=hooklab_ip:10m rate=20r/s;
limit_conn_zone $binary_remote_addr zone=hooklab_conn:10m;

server {
    listen 80;
    server_name hooklab.example.com;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name hooklab.example.com;
    ssl_certificate /etc/ssl/hooklab/fullchain.pem;
    ssl_certificate_key /etc/ssl/hooklab/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;
    client_body_timeout 10s;
    keepalive_timeout 15s;
    limit_req_status 429;
    limit_conn_status 429;

    # Provision tenants and scrape metrics through a private operations path.
    location = /health { return 403; }
    location = /metrics { return 403; }
    location = /api/admin/tenants { return 403; }

    location / {
        limit_req zone=hooklab_ip burst=40 nodelay;
        limit_conn hooklab_conn 20;
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Request-Id $request_id;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
