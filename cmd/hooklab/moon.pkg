import {
  "hooklab/hooklab/hooklab/config",
  "hooklab/hooklab/hooklab/contract",
  "hooklab/hooklab/hooklab/core",
  "hooklab/hooklab/hooklab/crypto",
  "hooklab/hooklab/hooklab/delivery",
  "hooklab/hooklab/hooklab/engine",
  "hooklab/hooklab/hooklab/gateway",
  "hooklab/hooklab/hooklab/outbound",
  "hooklab/hooklab/hooklab/pipeline",
  "hooklab/hooklab/hooklab/providers",
  "hooklab/hooklab/hooklab/report",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

pkgtype(kind: "executable")

options(
  targets: {
    "io_js.mbt": [ "js" ],
    "io_stub.mbt": [ "not", "js" ],
    "gateway_runtime_sqlite_js.mbt": [ "js" ],
    "environment_js.mbt": [ "js" ],
    "environment_stub.mbt": [ "not", "js" ],
    "gateway_runtime_stub.mbt": [ "not", "js" ],
  },
)
